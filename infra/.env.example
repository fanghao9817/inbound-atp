# copy to infra/.env on the server; never commit .env
POSTGRES_PASSWORD=change-me

# Shared by the API and the simulator for /api/internal/**. scripts/ensure-secrets.sh generates it.
INTERNAL_API_TOKEN=
# The simulator's private seed (knowing it would reveal every future "random" event). Generated too.
SIM_SEED=
# When the simulator took over (ISO instant, UTC). Set by scripts/reset-demo.sh; blank = first start.
SIM_GO_LIVE=
# false pauses the simulator without stopping its container
SIM_ENABLED=true

# Filled in by the deploy workflow from the AWS stack outputs
AVAILABILITY_URL=
PROJECTOR_FUNCTION=
